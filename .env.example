# Copy to .env and fill in. NEVER commit the real .env.
# These reuse the SAME cTrader credentials as the ctrader-connect project.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=

# demo | live. Telemetry Phase 1a runs on LIVE to measure the real broker.
CTRADER_ENV=live

# The ctidTraderAccountId (NOT the account login number).
CTRADER_ACCOUNT_ID=

# Reuse the token store written by ctrader-connect's OAuth flow, or seed via the
# env vars below. Point this at the existing tokens.json to share one credential.
TOKEN_STORE=../ctrader-connect/tokens.json
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=

# Where the telemetry SQLite database lives.
TELEMETRY_DB=data/telemetry.db

# Latency probe interval (seconds).
LATENCY_INTERVAL_S=30

# Council LLM keys (Claude proposes, Gemini red-teams). Without these the engine
# falls back to the deterministic mock backend.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
COUNCIL_ANTHROPIC_MODEL=claude-opus-5
COUNCIL_GEMINI_MODEL=gemini-2.5-flash

# Email delivery (so the engine can send reports itself).
# For Gmail, SMTP_PASS MUST be a 16-char App Password (Google account -> Security ->
# 2-Step Verification -> App passwords), NOT your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
